function quitModule()
    TOOLBOX_NAME  = "scicv";
    TOOLBOX_TITLE = "Scilab Computer Vision Module";

    [macros, tlbx_macros_dir] = libraryinfo("scicvlib");
    tlbx_root_dir = fullpath(tlbx_macros_dir + '/..');

    mprintf("Quit " + TOOLBOX_TITLE + "\n");

    mprintf("\tUnload help\n");
    del_help_chapter(TOOLBOX_NAME);

    mprintf("\tUnload gateways\n");
    exec(fullfile(tlbx_root_dir , "sci_gateway/unloader_gateway.sce"));

    mprintf("\tUnload libraries\n");
    exec(fullfile(tlbx_root_dir , "src/c/unloader_c.sce"));

    mprintf("\tUnload thirdparties\n");
    ulink(netcdf_ilib);
endfunction

quitModule();
clear quitModule;

mprintf("\tUnload macros\n");
clear('scicvlib');

//clear opncv_ilib;
