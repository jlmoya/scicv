SWIG       = @SWIG@
SWIG_LIB   = @SWIG_LIB@
export SWIG_LIB
OPENCV_INC = @OPENCV_INC@
SRCS       =
TARGET     = scicv
INTERFACE  = scicv.i
INCLUDES   = -I./include -I$(OPENCV_INC)

build:
	SWIG="$(SWIG)" OPENCV_INC="$(OPENCV_INC)" ./regen.sh

patch:
	SWIG="$(SWIG)" OPENCV_INC="$(OPENCV_INC)" ./regen.sh

clean:
	rm $(TARGET)_wrap.cxx lib$(TARGET).so
